# SquidWeave Environment Configuration
# Copy this to .env and fill in your values

# Server
PORT=4010
DRY_RUN=true

# LLM
LMSTUDIO_MODEL=google/gemma-3n-e4b
LOCALIZATION_MODEL=google/gemma-3n-e4b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000

# Connectors
DEFAULT_CONNECTOR=openclaw
OPENCLAW_BASE_URL=
OPENCLAW_TOKEN=
CLAWDBOT_BASE_URL=
CLAWDBOT_TOKEN=

# Hermes Memory (optional)
HERMES_BASE_URL=
HERMES_TOKEN=

# GHL Bridge (optional)
GHL_WEBHOOK_SECRET=
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_DEFAULT_CAMPAIGN_ID=

# ── Email (SMTP) — Free options: Brevo (300/day), SMTP2GO (1K/mo) ──
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login
SMTP_PASS=your-brevo-api-key
SMTP_FROM_NAME=SquidWeave
SMTP_FROM_EMAIL=you@yourdomain.com

# ── Social Publishing ──
# LinkedIn (free tier: 50 posts/mo)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_ORGANIZATION_URN=

# Twitter/X (free tier: 1500 req/mo)
TWITTER_BEARER_TOKEN=

# Telegram (free, unlimited)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ── Paid Ads (optional) ──
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=

# ── Email Enrichment (optional, all have free tiers) ──
HUNTER_API_KEY=
APOLLO_API_KEY=
SERPER_API_KEY=

# ── Tracking ──
TRACKING_BASE_URL=http://localhost:4010
TRACKING_SECRET=change-this-to-a-random-string

# ── Security ──
SQUIDWEAVE_API_KEY=
UI_USER=
UI_PASS=

# ── State Backend ──
DATABASE_URL=
STATE_BACKEND=
