# SquidWeave Environment Configuration
# Copy this file to .env and fill in the values you actually need.
# All variables are optional in development; production should set SQUIDWEAVE_API_KEY.

# Server
PORT=4010
HOST=127.0.0.1
NODE_ENV=development

# Safety (keep DRY_RUN=true until connectors are verified live)
DRY_RUN=true
REQUIRE_LIVE_APPROVAL=true
SCHEDULER_AUTOSTART=true

# Security (required in production)
SQUIDWEAVE_API_KEY=change-this-to-a-long-random-string
# UI_USER=admin
# UI_PASS=change-this-password

# Tracking
TRACKING_SECRET=change-this-to-a-random-string-of-at-least-32-characters
TRACKING_BASE_URL=http://localhost:4010
# Comma-separated list of domains click redirects are allowed to point to.
# If empty, click tracking allows any http(s) URL (not recommended in production).
# TRACKING_ALLOWED_DOMAINS=example.com,app.example.com

# State backend
# STATE_BACKEND=postgres
# DATABASE_URL=postgresql://user:pass@localhost:5432/squidweave
# POSTGRES_SCHEMA=public
# POSTGRES_STATE_TABLE=squidweave_state
# POSTGRES_STATE_KEY=primary
# Store high-volume outreach/analytics events in relational tables instead of the JSONB blob.
# Requires STATE_BACKEND=postgres.
# POSTGRES_RELATIONAL_EVENTS=true

# LLM providers
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000

# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=60000

LMSTUDIO_BASE_URL=http://127.0.0.1:1234
LMSTUDIO_MODEL=google/gemma-3n-e4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3n

# Connectors
DEFAULT_CONNECTOR=openclaw
# OPENCLAW_BASE_URL=
# OPENCLAW_TOKEN=
# CLAWDBOT_BASE_URL=
# CLAWDBOT_TOKEN=

# Hermes memory (optional)
# HERMES_BASE_URL=
# HERMES_TOKEN=

# GoHighLevel bridge (optional)
# GHL_API_KEY=
# GHL_LOCATION_ID=
# GHL_WEBHOOK_SECRET=
# GHL_DEFAULT_CAMPAIGN_ID=

# Email webhooks (optional, but strongly recommended in production)
# BREVO_WEBHOOK_SECRET=
# MAILGUN_API_KEY=

# Email (SMTP)
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM_NAME=SquidWeave
# SMTP_FROM_EMAIL=you@yourdomain.com

# Social publishing (optional)
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_PERSON_URN=
# LINKEDIN_ORGANIZATION_URN=
# TWITTER_BEARER_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=

# Paid ads (optional)
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# META_ADS_ACCESS_TOKEN=
# META_ADS_AD_ACCOUNT_ID=

# Enrichment (optional)
# HUNTER_API_KEY=
# APOLLO_API_KEY=
# SERPER_API_KEY=
# CRUNCHBASE_API_KEY=
# GITHUB_TOKEN=

# Scheduling / limits
SCHEDULER_INTERVAL_SECONDS=120

# Job queue (requires STATE_BACKEND=postgres and DATABASE_URL)
# JOB_QUEUE_ENABLED=true
# SYNC_JOBS=false

# Tier / entitlement
# TIER_MODE=free
# FREE_LLM_CALLS_PER_HOUR=10
# FREE_OUTREACH_BATCH_MAX=10
# FREE_ADS_CONNECTORS_ENABLED=false
RATE_LIMIT_MAX=120
MAX_OUTREACH_BATCH=50
MAX_FUNDING_BATCH=20
MAX_CONCURRENT_EXECUTIONS=1
MAX_BODY_SIZE_BYTES=1048576

# Agent / ops (optional)
# SQUIDWEAVE_API_BASE_URL=http://127.0.0.1:4010
# CLAWDBOT_ROLE=supervisor
# CLAWDBOT_INTERVAL_SECONDS=120
# GITHUB_TOKEN=
# TELEGRAM_CHAT_ID=
# RAILWAY_DEPLOYMENT_ID=
# RAILWAY_SERVICE_NAME=
