[Unit]
Description=LocaleWeave — Localized Marketing Automation Brain
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gnul
Group=gnul
WorkingDirectory=/home/gnul/squidweave
# Load environment from .env.local (loaded by src/load-env.mjs at import time)
# Run in production mode — DRY_RUN and PORT can be set in .env.local
Environment=NODE_ENV=production
Environment=LOCALEWEAVE_DATA_DIR=/home/gnul/squidweave/data
# The server loads .env.local automatically. Uncomment to force values:
# Environment=DRY_RUN=false
# Environment=PORT=4010
ExecStart=/usr/bin/node /home/gnul/squidweave/src/server.mjs
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
# Hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ProtectHome=false

[Install]
WantedBy=multi-user.target
