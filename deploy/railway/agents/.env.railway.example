# Shared for all Clawdbot/OpenClaw agent services
NODE_ENV=production
SQUIDWEAVE_API_BASE_URL=http://squidweave-api.railway.internal:4010
SQUIDWEAVE_AUTH_TOKEN=must-match-api-AUTH_TOKEN
SQUIDWEAVE_SITE_URL=https://knol3j.github.io/squidweave/
GITHUB_REPOSITORY=knol3j/squidweave

# Optional but recommended for GitHub Actions/dependabot monitoring and reruns
GITHUB_TOKEN=
CLAWDBOT_RERUN_FAILED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_LEVELS=error

# Per-service examples:
# clawdbot-health
CLAWDBOT_ROLE=health
CLAWDBOT_NAME=clawdbot-health
CLAWDBOT_INTERVAL_SECONDS=60

# clawdbot-bootstrap
# CLAWDBOT_ROLE=bootstrap
# CLAWDBOT_NAME=clawdbot-bootstrap
# CLAWDBOT_INTERVAL_SECONDS=21600
# CLAWDBOT_AUTOMATION_ARGS=--full

# clawdbot-enrichment
# CLAWDBOT_ROLE=enrichment
# CLAWDBOT_NAME=clawdbot-enrichment
# CLAWDBOT_INTERVAL_SECONDS=1800

# clawdbot-funding
# CLAWDBOT_ROLE=funding
# CLAWDBOT_NAME=clawdbot-funding
# CLAWDBOT_INTERVAL_SECONDS=7200
# SQUIDWEAVE_FUNDING_LIMIT=10
# SQUIDWEAVE_FUNDING_RETRY_ATTEMPTS=3

# clawdbot-ci
# CLAWDBOT_ROLE=ci
# CLAWDBOT_NAME=clawdbot-ci
# CLAWDBOT_INTERVAL_SECONDS=180

# clawdbot-audit
# CLAWDBOT_ROLE=audit
# CLAWDBOT_NAME=clawdbot-audit
# CLAWDBOT_INTERVAL_SECONDS=900
