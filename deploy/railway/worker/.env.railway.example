# Hermes Telegram worker service (Railway)
NODE_ENV=production
HERMES_HOME=/app/.hermes

# Required to connect to SquidWeave API service
SQUIDWEAVE_API_BASE_URL=http://squidweave-api.railway.internal:4010
SQUIDWEAVE_AUTH_TOKEN=must-match-api-AUTH_TOKEN

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Model/provider keys for autonomous agent activity
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional
HERMES_SETUP_ON_BOOT=false
