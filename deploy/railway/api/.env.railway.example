# SquidWeave API service (Railway)
NODE_ENV=production
PORT=4010
HOST=0.0.0.0

# Protect API so only trusted callers (Hermes worker) can mutate state
AUTH_TOKEN=replace-with-long-random-token

# CORS
ALLOWED_ORIGINS=https://your-frontend-domain.up.railway.app

# Storage
STORE_TYPE=sqlite
DB_PATH=/app/data/squidweave.db
MAX_BACKUPS=5

# Logging and limits
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# Optional model/provider vars for content generation
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
