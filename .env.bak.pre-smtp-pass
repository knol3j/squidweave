# SquidWeave local environment — generated during debugging
PORT=4010
DRY_RUN=false

# Auth credentials for the UI login and API access.
# Change these to strong values before exposing the server.
SQUIDWEAVE_API_KEY=change-me-in-production
UI_USER=squidweave
UI_PASS=temp123

# State backend: file | postgres | relational
DATABASE_URL=postgresql://squidweave:squidweave@127.0.0.1:5432/squidweave
STATE_BACKEND=relational

STATIC_DIR=./ui/dist

# ─── Proton Mail Bridge (local IMAP/SMTP) ─────────────────────────────────────
# The bridge daemon (systemd --user unit protonmail-bridge.service) exposes IMAP on
# 1143 and SMTP on 1025. It encrypts and signs on the way out and decrypts inbound
# mail, so the platform talks plaintext SMTP to localhost and Proton handles the rest.
#
# SMTP_PASS is the per-mailbox password Bridge generates, NOT the Proton account
# password. Bridge prints it when the account is added; paste it here once.
# Until it is filled in, sends fail auth and DRY_RUN above keeps that harmless.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=nweeces@squidweave.com
SMTP_PASS=
SMTP_FROM_NAME=SquidWeave
SMTP_FROM_EMAIL=nweeces@squidweave.com

# useTLS=false tells the adapter to STARTTLS after EHLO, which is what Bridge expects.
SMTP_USE_TLS=false
IMAP_HOST=127.0.0.1
IMAP_PORT=1143
IMAP_USER=nweeces@squidweave.com

# The Bridge-generated mailbox password is stored outside .env (mode 600) so it is not
# committed alongside the rest of the config. Regenerate it with `info` in the bridge
# CLI if auth ever starts failing.
BRIDGE_MAILBOX_PASS_FILE=/home/gnul/.bridge-mailbox-pass
