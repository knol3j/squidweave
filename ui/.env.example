# SquidWeave UI Environment Variables
# Copy this file to .env.local and fill in your values.
# Vite only exposes env vars prefixed with VITE_ to the browser.

# Main agent-platform backend (required)
VITE_API_URL=http://127.0.0.1:4010

# Marketing OS backend (optional, used by Advertising page)
VITE_MARKETING_API_URL=http://localhost:3001

# Backend API key (matches SQUIDWEAVE_API_KEY in the root .env)
VITE_API_KEY=change-this-to-a-long-random-string

# Tier / entitlement (matches TIER_MODE in the root .env)
# free = marketing automation + investment outreach only
# paid = unlock paid ads connectors, higher LLM allowance, larger outreach batches
# unlimited = remove limits for self-hosted / enterprise deployments
VITE_TIER_MODE=free
